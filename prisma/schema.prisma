generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TUTOR
  STUDENT
}

enum StudentGroup {
  JUNIOR_HIGH
  UNDERGRAD
  GRAD
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum BlockType {
  MARKDOWN
  EQUATION
  CODE_SNIPPET
  FILE_ATTACHMENT
  CODE_EDITOR
  VISUALIZATION
  VIDEO_EMBED
  // later phases append: QUIZ_REF
}

enum SessionStatus {
  PROPOSED
  CONFIRMED
  RESCHEDULE_REQUESTED_BY_STUDENT
  RESCHEDULE_REQUESTED_BY_TUTOR
  CANCELLED
  // The session happened and the tutor closed it out (attendance + notes).
  COMPLETED
  // The tutor can't make it; the student picks a new time from availability.
  // Its old time is released, so it holds no slot while in this state.
  AWAITING_RESCHEDULE
}

enum Attendance {
  ATTENDED
  NO_SHOW
}

/** Interface language. Course and quiz content stays in whatever language it was written. */
enum Language {
  ID
  EN
}

/** Who can open a course without the tutor putting them on it. */
enum CourseAccess {
  ENROLLED // only students the tutor enrolled, or a syllabus let in
  OPEN // any signed-in student — the free course
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  NUMERIC
  SHORT_TEXT
  CODE
  // Structured formats. Their shape lives in Question.correctAnswer, like
  // every other type, so they need no columns of their own.
  STEPS        // a problem worked through in ordered steps, each checked
  MULTI_PART   // one stem with parts (a)(b)(c), each carrying its own marks
  FIND_MISTAKE // a worked solution with one wrong step, for the student to spot
  PROJECT_STEP // one step of a guided project: an instruction plus the runs that check it
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

// How a quiz plays for the student. New styles are added one at a time, each
// with its own player, so a value here always means a style that works.
enum QuizStyle {
  CLASSIC // every question on one page, untimed, retake freely
  TRYOUT  // exam simulation: one question at a time against the clock
  MASTERY // practice: one question at a time, checked instantly, until each is right once
  DRILL   // practice: timed rounds of generated questions, aiming for a target score
  REVIEW  // practice: a mixed set drawn from earlier chapters, for spaced revision
  EXAM    // graded: a try-out you only get one go at
  PROJECT // graded: a guided project in a mini editor, one PROJECT_STEP question per step
}

enum SubmissionStatus {
  AUTO_GRADED
  PENDING_REVIEW
  REVIEWED
}

model User {
  id                String        @id @db.Uuid // = Supabase auth.users.id
  email             String        @unique
  name              String
  role              Role          @default(STUDENT)
  studentGroup      StudentGroup? // display/defaults only, not an access constraint
  language          Language      @default(ID)
  emailVerifiedAt   DateTime?
  enrollments       Enrollment[]
  ownedCourses      Course[]      @relation("CourseOwner")
  sessionsAsStudent Session[]     @relation("SessionStudent")
  sessionsAsTutor   Session[]     @relation("SessionTutor")
  submissions       Submission[]
  submissionAttempts SubmissionAttempt[]
  lessonProgress    LessonProgress[]
  availability      Availability[]
  seriesAsTutor     SessionSeries[] @relation("SeriesTutor")
  seriesAsStudent   SessionSeries[] @relation("SeriesStudent")
  calendarFeed      CalendarFeedToken?
  billingPlans      BillingPlan[]
  invoices          Invoice[]
  timedQuizSessions TimedQuizSession[]
  practiceProgress  PracticeProgress[]
  projectProgress   ProjectProgress[]
  verificationTokens EmailVerificationToken[]
  syllabusRequests  SyllabusRequest[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Course -> Chapter -> Lesson. The physical tables are still named Track and
// Module (and the FK columns trackId/moduleId): production shares this
// database with local dev, so renaming them for real would break the deployed
// app the instant the migration ran, before the new code shipped. @@map/@map
// keep the storage exactly as it is while the app speaks the new vocabulary.
// Renaming the tables themselves is a separate, deliberate exercise.
model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String       @default("")
  // Storage path of the uploaded cover in the attachments bucket. Served through
  // an access-checked route, never linked directly; null shows the letter tile.
  coverImagePath String?
  // Catalogue facets for finding a course among hundreds. Free text on purpose:
  // the catalogue spans curricula (Kurikulum Merdeka, Cambridge…) and general
  // courses (Excel for beginners…) that nobody can enumerate up front. The
  // tutor UI suggests values already in use so they stay consistent.
  subject     String?
  curriculum  String?
  level       String?
  status      CourseStatus @default(PUBLISHED)
  /// OPEN lets any signed-in student in; they're enrolled the moment they open it.
  access      CourseAccess @default(ENROLLED)
  ownerId     String       @db.Uuid
  owner       User         @relation("CourseOwner", fields: [ownerId], references: [id])
  chapters    Chapter[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("Track")
  sessions      Session[]
  sessionSeries SessionSeries[]
  billingPlans  BillingPlan[]
  invoiceItems  InvoiceItem[]
  allowances    InvoiceAllowance[]
  syllabusCourses SyllabusCourse[]
}

/** How a student came to have access — for the record, never for the check. */
enum EnrollmentSource {
  TUTOR // the tutor put them on it
  OPEN // they opened a course that's open to everyone
  SYLLABUS // they joined, or were approved for, a syllabus holding this course
}

model Enrollment {
  studentId String   @db.Uuid
  courseId  String   @map("trackId") @db.Uuid
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source    EnrollmentSource @default(TUTOR)
  /// The syllabus that granted it, if one did.
  syllabusId String? @db.Uuid
  syllabus  Syllabus? @relation(fields: [syllabusId], references: [id], onDelete: SetNull)
  /// Null means forever. Timed access needs no migration when it arrives.
  expiresAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now())

  @@id([studentId, courseId])
  @@index([courseId])
}

model Chapter {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("trackId") @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  lessons   Lesson[]
  quizzes   Quiz[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, order])
  @@map("Module")
}

model Lesson {
  id        String         @id @default(uuid()) @db.Uuid
  chapterId String         @map("moduleId") @db.Uuid
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  status    LessonStatus   @default(DRAFT)
  blocks    ContentBlock[]
  quizzes   Quiz[]
  progress  LessonProgress[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([chapterId, order])
}

model ContentBlock {
  id        String    @id @default(uuid()) @db.Uuid
  lessonId  String    @db.Uuid
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order     Int
  type      BlockType
  data      Json // shape validated per-type by Zod at the app boundary
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([lessonId, order])
}

// A student's progress through one lesson. A row exists as soon as they open
// the lesson; `completedAt` stays null until they actually mark it done, so
// "started" and "finished" are distinguishable and the course page can offer a
// resume point rather than only a percentage.
model LessonProgress {
  studentId    String    @db.Uuid
  lessonId     String    @db.Uuid
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime? @db.Timestamptz(3)
  lastViewedAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@id([studentId, lessonId])
  @@index([lessonId])
}

model Session {
  id              String        @id @default(uuid()) @db.Uuid
  studentId       String        @db.Uuid
  tutorId         String        @db.Uuid
  student         User          @relation("SessionStudent", fields: [studentId], references: [id])
  tutor           User          @relation("SessionTutor", fields: [tutorId], references: [id])
  startTime       DateTime      @db.Timestamptz(3)
  durationMinutes Int
  status          SessionStatus @default(CONFIRMED)
  notes           String        @default("")
  // Pending alt-time proposal. Which side proposed it is encoded by `status`:
  // *_BY_STUDENT means the student's proposal is awaiting the tutor's response,
  // and vice versa. A counter-proposal overwrites this and flips the status —
  // no history of earlier proposals is kept.
  proposedAltTime DateTime?     @db.Timestamptz(3)
  // Why a session was cancelled or needs a new time. Shown to the student.
  statusReason    String?
  cancelledAt     DateTime?     @db.Timestamptz(3)
  // Recorded when the tutor marks a session done.
  attendance      Attendance?
  // Set when this session was generated from a repeating booking. Occurrences
  // are edited and cancelled individually — moving one never touches its
  // siblings — so this is a provenance link, not a source of truth for timing.
  seriesId        String?       @db.Uuid
  series          SessionSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  // Which subject this session was for. Null means it predates subjects on
  // sessions, or the tutor teaches this student one thing only; billing then
  // falls back to the student's any-subject arrangement.
  courseId        String?       @db.Uuid
  course          Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // The invoice line this session was billed on, if it has been.
  invoiceItem     InvoiceItem?

  @@index([tutorId, startTime])
  @@index([studentId, startTime])
  @@index([seriesId])
}

// A weekly window the tutor is open to teach in, as a weekday plus a start
// time in minutes from midnight. Interpreted in APP_TZ_OFFSET_MINUTES (see
// src/lib/scheduling.ts) rather than stored as an instant, because "Tuesdays
// at 4pm" is the thing being described, not one particular Tuesday.
model Availability {
  id              String   @id @default(uuid()) @db.Uuid
  tutorId         String   @db.Uuid
  tutor           User     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  weekday         Int // 0 = Sunday .. 6 = Saturday
  startMinute     Int // minutes from local midnight
  durationMinutes Int
  // Closed rather than deleted, so past bookings keep their context.
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tutorId, weekday])
}

// The recipe a repeating booking was generated from. Sessions are materialised
// up front rather than computed on read, so each one can be moved, cancelled
// or annotated on its own without the series having to model exceptions.
model SessionSeries {
  id              String    @id @default(uuid()) @db.Uuid
  tutorId         String    @db.Uuid
  studentId       String    @db.Uuid
  tutor           User      @relation("SeriesTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student         User      @relation("SeriesStudent", fields: [studentId], references: [id], onDelete: Cascade)
  weekday         Int
  startMinute     Int
  durationMinutes Int
  occurrences     Int
  startsOn        DateTime  @db.Timestamptz(3)
  // The subject the occurrences are for; each session copies it when created.
  courseId        String?   @db.Uuid
  course          Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sessions        Session[]
  createdAt       DateTime  @default(now())

  @@index([tutorId])
  @@index([studentId])
}

// Bearer token in a personal .ics subscription URL. One per user, regenerated
// to revoke — anyone holding the link can read that person's schedule.
model CalendarFeedToken {
  token     String   @id
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Quiz {
  id            String       @id @default(uuid()) @db.Uuid
  // Every quiz belongs to a chapter of the syllabus. With a lesson as well it is
  // that lesson's quiz and sits right after it; without one it is the chapter's
  // own assessment (a try-out) and sits after the chapter's last lesson.
  // Restrict, so deleting a chapter can never take students' quiz results with it.
  chapterId     String       @db.Uuid
  chapter       Chapter      @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  lessonId      String?      @db.Uuid
  lesson        Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title         String
  // Draft quizzes (and their questions, however incomplete) are invisible to
  // students — mirrors Lesson.status. DB default is PUBLISHED so the
  // existing pre-this-feature quizzes backfill unaffected; app-level create
  // paths (createQuiz, CSV commit) explicitly pass DRAFT for new quizzes.
  status        QuizStatus   @default(PUBLISHED)
  // Ties a quiz to the CSV/XLSX upload that (re-)created its questions —
  // re-uploading a corrected sheet targets the same quiz + batch id rather
  // than creating a duplicate. One upload always maps to exactly one quiz.
  importBatchId String?      @db.Uuid
  style         QuizStyle    @default(CLASSIC)
  // Try-out settings, only read when style is TRYOUT (which always has a time
  // limit). A classic quiz is untimed with unlimited retakes and keeps these
  // null/false — before styles existed, a time limit is what made a try-out.
  timeLimitMinutes       Int?     // null = untimed
  maxAttempts            Int?     // null = unlimited retakes
  randomizeQuestionOrder Boolean  @default(false)
  // Drill settings, only read when style is DRILL. A drill has no authored
  // questions — a generator makes fresh ones every round — so these say which
  // skill, how long a round lasts, and the score that counts as done.
  drillSkill             String?
  drillSeconds           Int?
  drillTarget            Int?
  // How many questions a review set draws from earlier chapters. Only read
  // when style is REVIEW; the questions themselves belong to other quizzes.
  reviewCount            Int?
  // A guided project's starter files, { "main.py": "…", "data.py": "…" }. Only
  // read when style is PROJECT; the steps themselves are its questions.
  projectFiles           Json?
  questions     Question[]
  submissions   Submission[]
  submissionAttempts SubmissionAttempt[]
  timedSessions TimedQuizSession[]
  practiceProgress PracticeProgress[]
  projectProgress ProjectProgress[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([chapterId])
  @@index([lessonId])
  @@index([importBatchId])
}

// A student's in-progress attempt at a timed quiz. Created when they hit
// "Start" (not on page load — an exam's clock shouldn't run while someone
// is just reading the instructions), and deleted once they submit. Exists
// purely so the countdown and the shuffled question order survive a page
// reload instead of resetting the clock or reshuffling mid-attempt.
model TimedQuizSession {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @db.Uuid
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId        String   @db.Uuid
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  startedAt     DateTime @default(now())
  questionOrder String[] // frozen shuffled Question ids for this attempt
  createdAt     DateTime @default(now())

  @@unique([studentId, quizId])
}

// A student's run through a practice-style quiz. Kept apart from Submission on
// purpose: practice must never reach a score, an average or the review queue,
// and a separate table makes that true by construction rather than by every
// query remembering to filter.
// A student's work on a guided project (style PROJECT). The files carry over
// from step to step, so the project grows as they go; finishing it turns it
// into a Submission for review, and this row stays as the record of how.
// Steps are tracked by question id, not position, so editing a project later
// can't scramble anyone's progress.
model ProjectProgress {
  studentId    String    @db.Uuid
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId       String    @db.Uuid
  quiz         Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  // The student's files as they are now, { "main.py": "…", … }.
  files        Json
  // The files as they were when the current step opened — what "restore this
  // file" goes back to, so a broken file never costs the student a step's work.
  stepStartFiles Json?
  // Steps whose check has passed. The current step is the first one not here.
  passedIds    String[]
  // Checks that failed before each step passed, { "<questionId>": 2 } — the score.
  failedChecks Json      @default("{}")
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@id([studentId, quizId])
  @@index([quizId])
}

model PracticeProgress {
  studentId   String    @db.Uuid
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String    @db.Uuid
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  // Questions answered correctly in the current run. A restart empties it.
  masteredIds String[]
  // The first time every question was mastered — the completion mark, which a
  // restart leaves alone.
  completedAt DateTime?
  runs        Int       @default(0) // completed runs (drills: rounds played)
  bestScore   Int?      // drills only: the best round
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([studentId, quizId])
  @@index([quizId])
}

model Question {
  id            String       @id @default(uuid()) @db.Uuid
  quizId        String       @db.Uuid
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order         Int
  type          QuestionType
  prompt        String
  points        Float        @default(1)
  explanation   String       @default("")
  options       String[]     @default([])
  // Shape depends on `type` — validated by Zod in src/lib/quiz/schema.ts
  // (mirrors the ContentBlock.data pattern from the content model).
  correctAnswer Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([quizId, order])
}

model Submission {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @db.Uuid
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String           @db.Uuid
  quiz        Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  // { questionId, response }[] — response shape depends on the question's type
  answers     Json
  autoScore   Float?
  manualScore Float?
  status      SubmissionStatus
  feedback    String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // One live submission per student per quiz — resubmitting overwrites the
  // previous attempt rather than creating a new row.
  @@unique([studentId, quizId])
}

// Score-history snapshot taken just before a resubmission overwrites the live
// Submission row. Keeps the "one live submission" model intact while letting
// students see how their score evolved across attempts. Answers are not
// snapshotted — only the graded outcome.
model SubmissionAttempt {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @db.Uuid
  student       User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId        String           @db.Uuid
  quiz          Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attemptNumber Int
  autoScore     Float?
  manualScore   Float?
  status        SubmissionStatus
  submittedAt   DateTime

  @@index([studentId, quizId])
}

// ---------------------------------------------------------------- billing
//
// Money is kept as whole rupiah in Int: the currency has no subunit in
// practice, and integers never drift the way floats do. One tutor, one
// currency, so no currency column.

// How a student pays. Each student's arrangement is its own row, so a price
// change is a new row and last month's invoice still says what was charged.
enum BillingKind {
  PER_SESSION // charged for each session held, at `amount` apiece
  MONTHLY // a fixed amount per month, whatever the number of sessions
  EXTERNAL // someone else pays (an agency, a platform) — sessions are tracked, never invoiced
  FREE // no charge
}

model BillingPlan {
  id               String      @id @default(uuid()) @db.Uuid
  studentId        String      @db.Uuid
  student          User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// The subject this arrangement covers. Null covers every subject that
  /// hasn't one of its own — a student can be monthly for maths and
  /// per-session for coding at the same time.
  courseId         String?     @db.Uuid
  course           Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind             BillingKind
  /// Whole rupiah: per session, or per month. Zero for EXTERNAL and FREE.
  amount           Int         @default(0)
  /// MONTHLY only: sessions the fee covers each month. Sessions beyond it
  /// aren't charged extra — they come out of the next month's allowance.
  /// Null = unlimited.
  includedSessions Int?
  /// EXTERNAL: who pays, e.g. "Superprof". Shown wherever the plan is.
  payer            String      @default("")
  /// The day this arrangement starts. The plan in force on a date is the latest one not after it.
  startsOn         DateTime    @db.Date
  note             String      @default("")
  createdAt        DateTime    @default(now())

  @@index([studentId, startsOn])
  @@index([courseId])
}

enum InvoiceStatus {
  DRAFT // being put together; the student can't see it
  SENT // the student can see it and owes it
  PAID // settled in full
  VOID // cancelled, kept for the record
}

/// One month's bill for one student. The period is a calendar month, but
/// stored as dates so an off-cycle invoice is still possible.
model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @db.Uuid
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Sequential, human-readable: INV-2026-09-0001. Unique across the platform.
  number      String        @unique
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime?     @db.Timestamptz(3)
  dueOn       DateTime?     @db.Date
  /// Shown to the student, e.g. payment instructions or what a discount was for.
  note        String        @default("")
  items       InvoiceItem[]
  payments    Payment[]
  allowances  InvoiceAllowance[]
  syllabusRequests SyllabusRequest[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([studentId, periodStart])
  @@index([status])
}

/// A line on an invoice. A line that came from a session points at it, which
/// is also what stops the same session being billed twice.
model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sessionId   String?  @unique @db.Uuid
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// The subject the line belongs to, so an invoice can group two subjects.
  courseId    String?  @db.Uuid
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  description String
  quantity    Int      @default(1)
  /// Whole rupiah; negative for a discount.
  unitAmount  Int
  order       Int      @default(0)

  @@index([invoiceId])
}

/**
 * A monthly arrangement's session allowance for the month this invoice bills.
 * Sessions beyond the allowance aren't charged: they come out of the next
 * month, which reads `carryOut` from here as its own `carryIn`. Written once
 * when the invoice is raised, so the arithmetic that produced a past invoice
 * stays readable.
 */
model InvoiceAllowance {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  courseId  String?  @db.Uuid
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  /// Sessions the monthly fee covers.
  granted   Int
  /// Sessions held in the month itself.
  used      Int
  /// The balance brought in: positive for sessions already taken against
  /// this allowance, negative for sessions the student is still owed.
  carryIn   Int      @default(0)
  /// What this month passes on: used + carryIn - granted. Negative means the
  /// fee paid for sessions that haven't happened yet — the student keeps them.
  carryOut  Int      @default(0)

  @@unique([invoiceId, courseId])
  @@index([courseId])
}

/// Money received, recorded by hand — a transfer, cash, whatever. Always
/// against an invoice, so "what is this payment for" is never a guess.
model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Int
  paidOn    DateTime @db.Date
  /// How it arrived: "Transfer BCA", "Tunai", "OVO".
  method    String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([invoiceId])
}


// ---------------------------------------------------------------- syllabi
//
// A syllabus is a course of study: several courses in order, where a later
// one opens only once the one before it has been passed. Access to a course
// is still an Enrollment and nothing else — joining a syllabus, or being
// approved for one, writes those rows. One way in, so no screen can forget
// to check a second one.

enum SyllabusAccess {
  OPEN // any signed-in student can join it themselves
  REQUEST // they ask, the tutor approves, and it opens once the invoice is paid
}

model Syllabus {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  description    String         @default("")
  /// Storage path of the cover in the attachments bucket, like a course's.
  coverImagePath String?
  status         CourseStatus   @default(DRAFT)
  access         SyllabusAccess @default(REQUEST)
  /// Whole rupiah, for a syllabus that has to be asked for. Zero means free.
  price          Int            @default(0)
  courses        SyllabusCourse[]
  requests       SyllabusRequest[]
  enrollments    Enrollment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
}

/// One course's place in a syllabus, and what passing it takes.
model SyllabusCourse {
  id         String   @id @default(uuid()) @db.Uuid
  syllabusId String   @db.Uuid
  syllabus   Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  courseId   String   @db.Uuid
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order      Int
  /// Percentage across the course's graded quizzes that counts as passed.
  passScore  Int      @default(75)
  /// Whether the course before this one has to be passed first. The first
  /// course is never gated; a later one can be opened up deliberately.
  requiresPrevious Boolean @default(true)

  @@unique([syllabusId, courseId])
  @@index([syllabusId, order])
}

enum RequestStatus {
  PENDING // waiting for the tutor
  AWAITING_PAYMENT // approved; the invoice is out and access waits on it
  GRANTED // paid (or free) — the courses are enrolled
  DECLINED
  WITHDRAWN // the student changed their mind
}

/// A student asking for a syllabus they can't just join.
model SyllabusRequest {
  id         String        @id @default(uuid()) @db.Uuid
  studentId  String        @db.Uuid
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  syllabusId String        @db.Uuid
  syllabus   Syllabus      @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  /// What the student said when asking, and what the tutor said back.
  message    String        @default("")
  reply      String        @default("")
  /// The invoice raised on approval; access opens when it is paid.
  invoiceId  String?       @db.Uuid
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  decidedAt  DateTime?     @db.Timestamptz(3)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([studentId, syllabusId])
  @@index([status])
}
