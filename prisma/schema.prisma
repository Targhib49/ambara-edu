generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TUTOR
  STUDENT
}

enum StudentGroup {
  JUNIOR_HIGH
  UNDERGRAD
  GRAD
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum BlockType {
  MARKDOWN
  EQUATION
  CODE_SNIPPET
  FILE_ATTACHMENT
  CODE_EDITOR
  VISUALIZATION
  VIDEO_EMBED
  // later phases append: QUIZ_REF
}

enum SessionStatus {
  PROPOSED
  CONFIRMED
  RESCHEDULE_REQUESTED_BY_STUDENT
  RESCHEDULE_REQUESTED_BY_TUTOR
  CANCELLED
  // The session happened and the tutor closed it out (attendance + notes).
  COMPLETED
  // The tutor can't make it; the student picks a new time from availability.
  // Its old time is released, so it holds no slot while in this state.
  AWAITING_RESCHEDULE
}

enum Attendance {
  ATTENDED
  NO_SHOW
}

/** Interface language. Course and quiz content stays in whatever language it was written. */
enum Language {
  ID
  EN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  NUMERIC
  SHORT_TEXT
  CODE
  // Structured formats. Their shape lives in Question.correctAnswer, like
  // every other type, so they need no columns of their own.
  STEPS        // a problem worked through in ordered steps, each checked
  MULTI_PART   // one stem with parts (a)(b)(c), each carrying its own marks
  FIND_MISTAKE // a worked solution with one wrong step, for the student to spot
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

// How a quiz plays for the student. New styles are added one at a time, each
// with its own player, so a value here always means a style that works.
enum QuizStyle {
  CLASSIC // every question on one page, untimed, retake freely
  TRYOUT  // exam simulation: one question at a time against the clock
  MASTERY // practice: one question at a time, checked instantly, until each is right once
  DRILL   // practice: timed rounds of generated questions, aiming for a target score
  REVIEW  // practice: a mixed set drawn from earlier chapters, for spaced revision
  EXAM    // graded: a try-out you only get one go at
}

enum SubmissionStatus {
  AUTO_GRADED
  PENDING_REVIEW
  REVIEWED
}

model User {
  id                String        @id @db.Uuid // = Supabase auth.users.id
  email             String        @unique
  name              String
  role              Role          @default(STUDENT)
  studentGroup      StudentGroup? // display/defaults only, not an access constraint
  language          Language      @default(ID)
  emailVerifiedAt   DateTime?
  enrollments       Enrollment[]
  ownedCourses      Course[]      @relation("CourseOwner")
  sessionsAsStudent Session[]     @relation("SessionStudent")
  sessionsAsTutor   Session[]     @relation("SessionTutor")
  submissions       Submission[]
  submissionAttempts SubmissionAttempt[]
  lessonProgress    LessonProgress[]
  availability      Availability[]
  seriesAsTutor     SessionSeries[] @relation("SeriesTutor")
  seriesAsStudent   SessionSeries[] @relation("SeriesStudent")
  calendarFeed      CalendarFeedToken?
  timedQuizSessions TimedQuizSession[]
  practiceProgress  PracticeProgress[]
  verificationTokens EmailVerificationToken[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Course -> Chapter -> Lesson. The physical tables are still named Track and
// Module (and the FK columns trackId/moduleId): production shares this
// database with local dev, so renaming them for real would break the deployed
// app the instant the migration ran, before the new code shipped. @@map/@map
// keep the storage exactly as it is while the app speaks the new vocabulary.
// Renaming the tables themselves is a separate, deliberate exercise.
model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String       @default("")
  // Storage path of the uploaded cover in the attachments bucket. Served through
  // an access-checked route, never linked directly; null shows the letter tile.
  coverImagePath String?
  // Catalogue facets for finding a course among hundreds. Free text on purpose:
  // the catalogue spans curricula (Kurikulum Merdeka, Cambridge…) and general
  // courses (Excel for beginners…) that nobody can enumerate up front. The
  // tutor UI suggests values already in use so they stay consistent.
  subject     String?
  curriculum  String?
  level       String?
  status      CourseStatus @default(PUBLISHED)
  ownerId     String       @db.Uuid
  owner       User         @relation("CourseOwner", fields: [ownerId], references: [id])
  chapters    Chapter[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("Track")
}

model Enrollment {
  studentId String   @db.Uuid
  courseId  String   @map("trackId") @db.Uuid
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([studentId, courseId])
  @@index([courseId])
}

model Chapter {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("trackId") @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  lessons   Lesson[]
  quizzes   Quiz[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, order])
  @@map("Module")
}

model Lesson {
  id        String         @id @default(uuid()) @db.Uuid
  chapterId String         @map("moduleId") @db.Uuid
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  status    LessonStatus   @default(DRAFT)
  blocks    ContentBlock[]
  quizzes   Quiz[]
  progress  LessonProgress[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([chapterId, order])
}

model ContentBlock {
  id        String    @id @default(uuid()) @db.Uuid
  lessonId  String    @db.Uuid
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order     Int
  type      BlockType
  data      Json // shape validated per-type by Zod at the app boundary
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([lessonId, order])
}

// A student's progress through one lesson. A row exists as soon as they open
// the lesson; `completedAt` stays null until they actually mark it done, so
// "started" and "finished" are distinguishable and the course page can offer a
// resume point rather than only a percentage.
model LessonProgress {
  studentId    String    @db.Uuid
  lessonId     String    @db.Uuid
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime? @db.Timestamptz(3)
  lastViewedAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@id([studentId, lessonId])
  @@index([lessonId])
}

model Session {
  id              String        @id @default(uuid()) @db.Uuid
  studentId       String        @db.Uuid
  tutorId         String        @db.Uuid
  student         User          @relation("SessionStudent", fields: [studentId], references: [id])
  tutor           User          @relation("SessionTutor", fields: [tutorId], references: [id])
  startTime       DateTime      @db.Timestamptz(3)
  durationMinutes Int
  status          SessionStatus @default(CONFIRMED)
  notes           String        @default("")
  // Pending alt-time proposal. Which side proposed it is encoded by `status`:
  // *_BY_STUDENT means the student's proposal is awaiting the tutor's response,
  // and vice versa. A counter-proposal overwrites this and flips the status —
  // no history of earlier proposals is kept.
  proposedAltTime DateTime?     @db.Timestamptz(3)
  // Why a session was cancelled or needs a new time. Shown to the student.
  statusReason    String?
  cancelledAt     DateTime?     @db.Timestamptz(3)
  // Recorded when the tutor marks a session done.
  attendance      Attendance?
  // Set when this session was generated from a repeating booking. Occurrences
  // are edited and cancelled individually — moving one never touches its
  // siblings — so this is a provenance link, not a source of truth for timing.
  seriesId        String?       @db.Uuid
  series          SessionSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tutorId, startTime])
  @@index([studentId, startTime])
  @@index([seriesId])
}

// A weekly window the tutor is open to teach in, as a weekday plus a start
// time in minutes from midnight. Interpreted in APP_TZ_OFFSET_MINUTES (see
// src/lib/scheduling.ts) rather than stored as an instant, because "Tuesdays
// at 4pm" is the thing being described, not one particular Tuesday.
model Availability {
  id              String   @id @default(uuid()) @db.Uuid
  tutorId         String   @db.Uuid
  tutor           User     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  weekday         Int // 0 = Sunday .. 6 = Saturday
  startMinute     Int // minutes from local midnight
  durationMinutes Int
  // Closed rather than deleted, so past bookings keep their context.
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tutorId, weekday])
}

// The recipe a repeating booking was generated from. Sessions are materialised
// up front rather than computed on read, so each one can be moved, cancelled
// or annotated on its own without the series having to model exceptions.
model SessionSeries {
  id              String    @id @default(uuid()) @db.Uuid
  tutorId         String    @db.Uuid
  studentId       String    @db.Uuid
  tutor           User      @relation("SeriesTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student         User      @relation("SeriesStudent", fields: [studentId], references: [id], onDelete: Cascade)
  weekday         Int
  startMinute     Int
  durationMinutes Int
  occurrences     Int
  startsOn        DateTime  @db.Timestamptz(3)
  sessions        Session[]
  createdAt       DateTime  @default(now())

  @@index([tutorId])
  @@index([studentId])
}

// Bearer token in a personal .ics subscription URL. One per user, regenerated
// to revoke — anyone holding the link can read that person's schedule.
model CalendarFeedToken {
  token     String   @id
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Quiz {
  id            String       @id @default(uuid()) @db.Uuid
  // Every quiz belongs to a chapter of the syllabus. With a lesson as well it is
  // that lesson's quiz and sits right after it; without one it is the chapter's
  // own assessment (a try-out) and sits after the chapter's last lesson.
  // Restrict, so deleting a chapter can never take students' quiz results with it.
  chapterId     String       @db.Uuid
  chapter       Chapter      @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  lessonId      String?      @db.Uuid
  lesson        Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title         String
  // Draft quizzes (and their questions, however incomplete) are invisible to
  // students — mirrors Lesson.status. DB default is PUBLISHED so the
  // existing pre-this-feature quizzes backfill unaffected; app-level create
  // paths (createQuiz, CSV commit) explicitly pass DRAFT for new quizzes.
  status        QuizStatus   @default(PUBLISHED)
  // Ties a quiz to the CSV/XLSX upload that (re-)created its questions —
  // re-uploading a corrected sheet targets the same quiz + batch id rather
  // than creating a duplicate. One upload always maps to exactly one quiz.
  importBatchId String?      @db.Uuid
  style         QuizStyle    @default(CLASSIC)
  // Try-out settings, only read when style is TRYOUT (which always has a time
  // limit). A classic quiz is untimed with unlimited retakes and keeps these
  // null/false — before styles existed, a time limit is what made a try-out.
  timeLimitMinutes       Int?     // null = untimed
  maxAttempts            Int?     // null = unlimited retakes
  randomizeQuestionOrder Boolean  @default(false)
  // Drill settings, only read when style is DRILL. A drill has no authored
  // questions — a generator makes fresh ones every round — so these say which
  // skill, how long a round lasts, and the score that counts as done.
  drillSkill             String?
  drillSeconds           Int?
  drillTarget            Int?
  // How many questions a review set draws from earlier chapters. Only read
  // when style is REVIEW; the questions themselves belong to other quizzes.
  reviewCount            Int?
  questions     Question[]
  submissions   Submission[]
  submissionAttempts SubmissionAttempt[]
  timedSessions TimedQuizSession[]
  practiceProgress PracticeProgress[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([chapterId])
  @@index([lessonId])
  @@index([importBatchId])
}

// A student's in-progress attempt at a timed quiz. Created when they hit
// "Start" (not on page load — an exam's clock shouldn't run while someone
// is just reading the instructions), and deleted once they submit. Exists
// purely so the countdown and the shuffled question order survive a page
// reload instead of resetting the clock or reshuffling mid-attempt.
model TimedQuizSession {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @db.Uuid
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId        String   @db.Uuid
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  startedAt     DateTime @default(now())
  questionOrder String[] // frozen shuffled Question ids for this attempt
  createdAt     DateTime @default(now())

  @@unique([studentId, quizId])
}

// A student's run through a practice-style quiz. Kept apart from Submission on
// purpose: practice must never reach a score, an average or the review queue,
// and a separate table makes that true by construction rather than by every
// query remembering to filter.
model PracticeProgress {
  studentId   String    @db.Uuid
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String    @db.Uuid
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  // Questions answered correctly in the current run. A restart empties it.
  masteredIds String[]
  // The first time every question was mastered — the completion mark, which a
  // restart leaves alone.
  completedAt DateTime?
  runs        Int       @default(0) // completed runs (drills: rounds played)
  bestScore   Int?      // drills only: the best round
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([studentId, quizId])
  @@index([quizId])
}

model Question {
  id            String       @id @default(uuid()) @db.Uuid
  quizId        String       @db.Uuid
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order         Int
  type          QuestionType
  prompt        String
  points        Float        @default(1)
  explanation   String       @default("")
  options       String[]     @default([])
  // Shape depends on `type` — validated by Zod in src/lib/quiz/schema.ts
  // (mirrors the ContentBlock.data pattern from the content model).
  correctAnswer Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([quizId, order])
}

model Submission {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @db.Uuid
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String           @db.Uuid
  quiz        Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  // { questionId, response }[] — response shape depends on the question's type
  answers     Json
  autoScore   Float?
  manualScore Float?
  status      SubmissionStatus
  feedback    String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // One live submission per student per quiz — resubmitting overwrites the
  // previous attempt rather than creating a new row.
  @@unique([studentId, quizId])
}

// Score-history snapshot taken just before a resubmission overwrites the live
// Submission row. Keeps the "one live submission" model intact while letting
// students see how their score evolved across attempts. Answers are not
// snapshotted — only the graded outcome.
model SubmissionAttempt {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @db.Uuid
  student       User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId        String           @db.Uuid
  quiz          Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attemptNumber Int
  autoScore     Float?
  manualScore   Float?
  status        SubmissionStatus
  submittedAt   DateTime

  @@index([studentId, quizId])
}
